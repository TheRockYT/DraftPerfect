---
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <section class="mx-auto max-w-6xl px-4 pb-16 pt-16 sm:px-6 sm:pt-24 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <p
                class="mb-4 inline-flex items-center rounded-full border border-accent/20 bg-accent-muted px-3.5 py-1.5 text-xs font-semibold text-accent shadow-sm"
            >
                University Application Toolkit
            </p>
            <h1
                class="text-balance text-4xl font-extrabold tracking-tight text-text sm:text-6xl"
            >
                Write your best <br/>
                <span class="text-accent">application essays</span>
            </h1>
            <p class="mt-6 text-balance text-lg sm:text-xl text-text-muted leading-relaxed">
                A distraction-free editor with real-time byte counting and automatic
                local saves. Your drafts never leave your browser.
            </p>
            <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
                <a
                    href="/editor"
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-8 py-4 text-base font-semibold text-white shadow-md transition-all duration-200 hover:bg-accent-hover hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                    Open Editor
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Feature Highlights Section -->
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 border-t border-border/60">
        <div class="mx-auto max-w-2xl text-center mb-12">
            <h2 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
                Everything you need to succeed
            </h2>
            <p class="mt-3 text-text-muted text-base sm:text-lg">
                Designed specifically for university applicants who value focus, precision, and privacy.
            </p>
        </div>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
            <!-- Feature 1 -->
            <div class="rounded-2xl border border-border bg-surface-raised p-6 shadow-xs transition-all duration-200 hover:border-accent/40">
                <div class="mb-4 inline-flex size-12 items-center justify-center rounded-xl bg-accent-muted text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
                <h3 class="text-lg font-semibold text-text">Distraction-Free</h3>
                <p class="mt-2 text-sm text-text-muted leading-relaxed">
                    Clean, minimalist writing space designed to eliminate clutter and keep you focused on your narrative.
                </p>
            </div>

            <!-- Feature 2 -->
            <div class="rounded-2xl border border-border bg-surface-raised p-6 shadow-xs transition-all duration-200 hover:border-accent/40">
                <div class="mb-4 inline-flex size-12 items-center justify-center rounded-xl bg-accent-muted text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                </div>
                <h3 class="text-lg font-semibold text-text">Real-Time Counting</h3>
                <p class="mt-2 text-sm text-text-muted leading-relaxed">
                    Accurately track characters, words, and byte lengths with support for multiple encodings and strict limit warnings.
                </p>
            </div>

            <!-- Feature 3 -->
            <div class="rounded-2xl border border-border bg-surface-raised p-6 shadow-xs transition-all duration-200 hover:border-accent/40">
                <div class="mb-4 inline-flex size-12 items-center justify-center rounded-xl bg-accent-muted text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <h3 class="text-lg font-semibold text-text">Automatic Local Saves</h3>
                <p class="mt-2 text-sm text-text-muted leading-relaxed">
                    Your drafts are securely saved in your browser's local storage instantly. No server required, 100% private.
                </p>
            </div>

            <!-- Feature 4 -->
            <div class="rounded-2xl border border-border bg-surface-raised p-6 shadow-xs transition-all duration-200 hover:border-accent/40">
                <div class="mb-4 inline-flex size-12 items-center justify-center rounded-xl bg-accent-muted text-accent">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                </div>
                <h3 class="text-lg font-semibold text-text">Multiple Drafts</h3>
                <p class="mt-2 text-sm text-text-muted leading-relaxed">
                    Easily manage, switch between, and export multiple essays and personal statements for different universities.
                </p>
            </div>
        </div>
    </section>

    <!-- Bottom CTA Section -->
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 text-center">
        <div class="rounded-3xl border border-border bg-surface-raised px-6 py-12 sm:py-16 sm:px-12 shadow-sm">
            <h2 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
                Ready to craft your winning application?
            </h2>
            <p class="mt-4 text-text-muted text-base sm:text-lg max-w-xl mx-auto">
                Jump straight into the editor and start writing your personal statement today.
            </p>
            <div class="mt-8">
                <a
                    href="/editor"
                    class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-8 py-4 text-base font-semibold text-white shadow-md transition-all duration-200 hover:bg-accent-hover hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
                >
                    Open Editor
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
            </div>
        </div>
    </section>
</Layout>
